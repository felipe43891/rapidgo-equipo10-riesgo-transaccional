{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Evento de pago RapidGo (v1)",
  "type": "object",
  "required": [
    "event_id", "order_id", "user_id", "timestamp", "amount", "currency",
    "payment_method", "device_id", "location", "attempt_number", "payment_status"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "team_id": { "type": "string" },
    "order_id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "amount": { "type": "number", "exclusiveMinimum": 0 },
    "currency": { "type": "string", "minLength": 1 },
    "payment_method": { "enum": ["card", "pse", "cash", "wallet"] },
    "device_id": { "type": "string", "minLength": 1 },
    "location": {
      "type": "object",
      "required": ["city", "lat", "lon"],
      "properties": {
        "city": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "attempt_number": { "type": "integer", "minimum": 1 },
    "payment_status": { "enum": ["approved", "rejected", "pending"] }
  }
}